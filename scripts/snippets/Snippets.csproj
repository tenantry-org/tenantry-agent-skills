<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The skills' code blocks, as scripts/check-snippets.sh builds them: scripts/extract-snippets.cs writes one file per block next to
    a copy of this project, and Ambient.cs supplies what a block takes for granted (a builder, an app, the app's own
    types). With IncludePro=true it also references the Tenantry Pro packages and builds the tenantry-pro skill's
    blocks, with ProAmbient.cs.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Only errors fail the check: a block may leave a variable unused or a method without an await. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Except Tenantry's analyzer warnings: no example may show a tenant mistake without saying it is meant. -->
    <WarningsAsErrors>$(WarningsAsErrors);TNY1001;TNY1002;TNY1004;TNY2001</WarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <IncludePro Condition="'$(IncludePro)' == ''">false</IncludePro>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tenantry.Core" Version="[$(TenantryVersion)]" />
    <PackageReference Include="Tenantry.AspNetCore" Version="[$(TenantryVersion)]" />
    <PackageReference Include="Tenantry.EfCore" Version="[$(TenantryVersion)]" />
    <PackageReference Include="Tenantry.Options" Version="[$(TenantryVersion)]" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <!-- The skills' tests. This is not a test project, so xUnit's attributes and assertions without its runner. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="xunit.v3.assert" Version="4.0.1" />
    <PackageReference Include="xunit.v3.extensibility.core" Version="4.0.1" />
  </ItemGroup>

  <!--
    Blocks are fragments of an application, and many leave out the using directives an editor adds: these two make
    the build check names and signatures, not whether a fragment repeats them.
  -->
  <ItemGroup>
    <Using Include="Tenantry" />
    <Using Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup Condition="'$(IncludePro)' == 'true'">
    <Using Include="Tenantry.Pro" />
    <PackageReference Include="Tenantry.Pro" Version="[$(TenantryProVersion)]" />
    <PackageReference Include="Tenantry.Pro.EfCore" Version="[$(TenantryProVersion)]" />
    <PackageReference Include="Tenantry.Pro.Hangfire" Version="[$(TenantryProVersion)]" />
    <PackageReference Include="Hangfire.Core" Version="1.8.25" />
    <PackageReference Include="Hangfire.InMemory" Version="1.0.0" />
    <PackageReference Include="Hangfire.NetCore" Version="1.8.25" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup Condition="'$(IncludePro)' != 'true'">
    <Compile Remove="ProAmbient.cs" />
  </ItemGroup>

</Project>
